# ChíaVial · variables de PRODUCCIÓN
# Copie este archivo como .env en la carpeta del proyecto en el VPS (junto a docker-compose.prod.yml).
# Nunca suba el .env a GitHub.

# Dominio público con https (el que configuró en aaPanel)
APP_URL=https://chiavial.midominio.co

# Base de datos (contraseña larga; solo la usa el contenedor de la app)
DB_PASSWORD=cambie-esta-clave-larga

# Secretos: genere cada uno con  openssl rand -base64 32
JWT_SECRET=
CIFRADO_CLAVE=

# Primer administrador (se crea al primer arranque si no existe ninguno). Cambie la clave al ingresar.
ADMIN_EMAIL=admin@midominio.co
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador ChíaVial

# Correo saliente (SMTP). Sin SMTP, los correos quedan en Administración → Correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=ChíaVial <no-responder@midominio.co>

# Telegram (cree el bot con @BotFather). Modo polling: no hay que abrir puertos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODO=polling
TELEGRAM_WEBHOOK_SECRET=

# Datos abiertos: csv (archivos incluidos en la imagen) o api (datos.gov.co)
INGESTA_FUENTE=csv
INGESTA_CADA_HORAS=168
SOCRATA_APP_TOKEN=

# Geocodificación (Nominatim exige un User-Agent con contacto)
GEOCODER=nominatim
NOMINATIM_USER_AGENT=ChiaVial/1.0 (proyecto universitario; admin@midominio.co)
