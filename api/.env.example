# Copie este archivo como .env y ajuste los valores
DATABASE_URL=postgres://chiavial:chiavial@localhost:5432/chiavial
JWT_SECRET=escriba-aqui-un-secreto-largo-y-aleatorio
APP_URL=http://localhost:5173

# Primer administrador (se crea al iniciar si no existe ninguno)
ADMIN_EMAIL=admin@chiavial.local
ADMIN_PASSWORD=Admin12345

# Correo (sin SMTP, los correos quedan en Administración → Correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ChíaVial <no-responder@chiavial.local>

# Ingesta de datos abiertos: csv (archivos en ../data) o api (descarga de datos.gov.co)
INGESTA_FUENTE=csv
SOCRATA_APP_TOKEN=
# Horas entre ingestas automáticas (0 = desactivada)
INGESTA_CADA_HORAS=168

# Geocodificación: nominatim u off
GEOCODER=nominatim
NOMINATIM_USER_AGENT=ChiaVial/1.0 (proyecto universitario; correo-de-contacto@ejemplo.co)

# ───────── Cifrado (AES-256-GCM) ─────────
# Clave maestra de 32 bytes en base64. Genérela con:  openssl rand -base64 32   (o: npm run clave)
# Sin ella, en desarrollo se usa una clave fija de prueba; en producción el servidor no arranca.
# ¡No la pierda ni la cambie! Sin la clave original no se pueden descifrar las placas ni los chats ya guardados.
CIFRADO_CLAVE=

# Cookie de sesión con atributo Secure (por defecto true si APP_URL empieza por https://)
# COOKIE_SECURE=true

# ───────── Mensajería por Telegram ─────────
# Cree el bot con @BotFather (/newbot) y copie el token. Sin token, el canal queda desactivado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (recomendado: no requiere abrir puertos) | webhook (requiere HTTPS público) | off
TELEGRAM_MODO=polling
# Solo para modo webhook: secreto aleatorio de 16+ caracteres (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
